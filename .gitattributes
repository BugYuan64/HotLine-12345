# 默认所有文本文件使用 LF 存储
* text=auto eol=lf

# 前端源码强制 LF
*.js text eol=lf
*.vue text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf

# Java 源码强制 LF
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# Python 源码强制 LF
*.py text eol=lf

# SQL 文件强制 LF
*.sql text eol=lf

# 二进制文件不处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.jar binary
*.class binary
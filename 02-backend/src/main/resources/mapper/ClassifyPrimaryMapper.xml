<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.tjetc.backend.mapper.admin.ClassifyPrimaryMapper">

    <sql id="baseColumns">
        id, code, name, department, sort_order, status
    </sql>

    <select id="selectAll" resultType="org.tjetc.backend.entity.admin.ClassifyPrimary">
        SELECT <include refid="baseColumns"/>
        FROM classify_primary
        ORDER BY sort_order, id
    </select>

    <select id="selectEnabled" resultType="org.tjetc.backend.entity.admin.ClassifyPrimary">
        SELECT <include refid="baseColumns"/>
        FROM classify_primary
        WHERE status = 'ENABLED'
        ORDER BY sort_order, id
    </select>

    <select id="selectById" resultType="org.tjetc.backend.entity.admin.ClassifyPrimary">
        SELECT <include refid="baseColumns"/>
        FROM classify_primary
        WHERE id = #{id}
    </select>

    <select id="selectByCode" resultType="org.tjetc.backend.entity.admin.ClassifyPrimary">
        SELECT <include refid="baseColumns"/>
        FROM classify_primary
        WHERE code = #{code}
        LIMIT 1
    </select>

    <insert id="insert" parameterType="org.tjetc.backend.entity.admin.ClassifyPrimary" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO classify_primary (code, name, department, sort_order, status)
        VALUES (#{code}, #{name}, #{department}, #{sortOrder}, #{status})
    </insert>

    <update id="update" parameterType="org.tjetc.backend.entity.admin.ClassifyPrimary">
        UPDATE classify_primary
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="department != null">department = #{department},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM classify_primary
        WHERE id = #{id}
    </delete>

</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.tjetc.backend.mapper.admin.SysMenuMapper">

    <select id="selectAll" resultType="map">
        SELECT id, code, name, parent_id, route, perm, sort_order
        FROM sys_menu
        ORDER BY sort_order, id
    </select>

    <select id="selectMenuIdsByRoleId" resultType="long">
        SELECT menu_id FROM sys_role_menu WHERE role_id = #{roleId}
    </select>

    <delete id="deleteByRoleId">
        DELETE FROM sys_role_menu WHERE role_id = #{roleId}
    </delete>

    <insert id="insertBatch">
        INSERT INTO sys_role_menu (role_id, menu_id)
        VALUES
        <foreach collection="menuIds" item="mid" separator=",">
            (#{roleId}, #{mid})
        </foreach>
    </insert>

</mapper>
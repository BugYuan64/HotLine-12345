# ============ 阿里云 DashScope（通义千问）配置 ============
# 密钥未配置时：分类自动降级为纯关键词规则（API 文档定义的降级行为）
DASHSCOPE_API_KEY=***
# OpenAI 兼容模式地址（默认即可）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 大模型与 Embedding 模型
LLM_MODEL=qwen3.7-plus
# 衔接建议专用轻量模型（每次回答后生成追问建议；旗舰模型非流式调用必超时，务必用快模型）
SUGGEST_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v1
# 向量维度（text-embedding-v1 输出 1024 维；勿改 v3/1536，会导致 RAG 维度错误）
EMBEDDING_DIM=1024

# ============ Redis Stack（向量库 + 分类知识桥） ============
# 内网签名密钥：必须与 02-backend 的 AI_SIGN_SECRET 保持一致，单侧修改将导致 Java 调 AI 全部 401
INTERNAL_SIGN_SECRET=hotline-ai-internal-sign-secret
REDIS_HOST=192.168.1**.100
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RAG_INDEX=rag_idx

# ============ 内网签名（与 Java 端 app.ai.sign-secret 保持一致） ============
INTERNAL_SIGN_SECRET=hotline-ai-internal-sign-secret
SIGN_TOLERANCE_SECONDS=300
# IP 白名单（逗号分隔，留空不限制；生产环境由 Nginx 限制仅 Java 服务可访问）
ALLOWED_IPS=

# ============ 分类参数 ============
# 低置信度阈值：低于该值标记 need_review=true 进入人工复核
CONFIDENCE_THRESHOLD=0.6
# RAG 相似度参考阈值
RAG_SIMILARITY_THRESHOLD=0.75
RAG_TOP_K=5

# ============ AI 助手（智能客服升级：四端 AI 助手工具调用） ============
# Java 业务服务内网地址：AI 助手工具回调查询业务数据（Java /internal/agent/*，权限按登录用户过滤）
JAVA_BASE_URL=http://localhost:8080
# 是否启用 AI 助手工具（四端）；false 时保持原 RAG 纯知识问答
AGENT_ENABLED=true